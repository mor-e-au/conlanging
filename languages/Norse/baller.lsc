Class c {b, d, g, p, t, k, th, dh, n, m, r, l, s, z, j, h, f, w, qu}
Class v {a, e, i, o, u, y, á, é, í, ó, ú, ý, ô, æ, ø, ā, ē, ī, ō, ū}

pre:
    {au, ey} => æ

v:
    {jó, já, jǫ, jú} => {jau, já, jø, jo}
    {á, ó, ú, é, í, ý} => {á, ó, ú, æ, í, jø}
    {a, e, i, o, u, y} => {a, e, i, o, u, ø}
    ǫ => ø
    then: a => o / _ l

c:
    {th, þ, ð, dh} => {t, t, ð, ð}
    r => * / @c _ $
